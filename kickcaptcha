-- Script Auto-Kick mạnh hơn, dành riêng cho môi trường Cloud Phone
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Kiểm tra theo kiểu "brute force" - quét mọi thứ trên màn hình
task.spawn(function()
    while true do
        task.wait(10) -- Quét mỗi 10 giây cho nhẹ máy
        
        -- Quét toàn bộ CoreGui và PlayerGui
        local guis = {game:GetService("CoreGui"), LocalPlayer:FindFirstChildOfClass("PlayerGui")}
        
        for _, gui in pairs(guis) do
            if gui then
                for _, descendant in pairs(gui:GetDescendants()) do
                    -- Kiểm tra nếu là Text hoặc đối tượng có tên liên quan đến Security/Captcha
                    if (descendant:IsA("TextLabel") or descendant:IsA("TextButton") or descendant:IsA("TextBox")) then
                        local text = string.lower(descendant.Text)
                        if text:find("verifying") or text:find("security") or text:find("verification") or text:find("captcha") then
                            LocalPlayer:Kick("\n[AUTO-KICK]\nPhát Hiện Captcha, Chờ Rejon !")
                        end
                    end
                end
            end
        end
    end
end)
