local CoreGui = game:GetService("CoreGui")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local kickReason = "Phát Hiện Captcha, Chờ Rejon !"
local keywords = {
    "Verifying you're not a",
    "Verification",
    "Security",
    "Captcha"
}

-- Hàm quét và thực hiện Kick
local function scanAndKick()
    local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    
    -- Gom toàn bộ UI trong CoreGui và PlayerGui để quét
    local targets = {}
    for _, item in ipairs(CoreGui:GetDescendants()) do table.insert(targets, item) end
    if playerGui then
        for _, item in ipairs(playerGui:GetDescendants()) do table.insert(targets, item) end
    end

    -- Kiểm tra từ khóa
    for _, instance in ipairs(targets) do
        if instance:IsA("TextLabel") or instance:IsA("TextButton") then
            local text = instance.Text
            for _, word in ipairs(keywords) do
                if string.find(string.lower(text), string.lower(word)) then
                    LocalPlayer:Kick("\n[AUTO-KICK]\n" .. kickReason)
                    return true -- Phát hiện xong dừng luôn
                end
            end
        end
    end
    return false
end

-- Vòng lặp tự động chạy mỗi 120 giây
task.spawn(function()
    while true do
        local isKicked = scanAndKick()
        if isKicked then break end -- Nếu đã Kick thì ngắt vòng lặp
        task.wait(120) -- Đợi 120 giây (2 phút) rồi mới quét lại
    end
end)
